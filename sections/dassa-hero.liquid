<section class="hero grain" id="hero">
  <div class="hero-bubbles" aria-hidden="true">
    <span class="bubble" style="left:8%;width:10px;height:10px;animation-duration:9s"></span>
    <span class="bubble" style="left:18%;width:6px;height:6px;animation-duration:12s;animation-delay:2s"></span>
    <span class="bubble" style="left:30%;width:14px;height:14px;animation-duration:10s;animation-delay:4s"></span>
    <span class="bubble" style="left:45%;width:8px;height:8px;animation-duration:13s;animation-delay:1s"></span>
    <span class="bubble" style="left:60%;width:12px;height:12px;animation-duration:9.5s;animation-delay:3s"></span>
    <span class="bubble" style="left:72%;width:7px;height:7px;animation-duration:11s;animation-delay:5s"></span>
    <span class="bubble" style="left:85%;width:11px;height:11px;animation-duration:10.5s;animation-delay:2.5s"></span>
  </div>
  <div class="container hero-grid">
    <div class="hero-left">
      <p class="hero-kicker reveal-up">{{ section.settings.kicker }}</p>
      <p class="hero-brand reveal-up">DASSA<span class="accent-dot-yellow">.</span></p>
      <h1 class="hero-title">
        <span class="line-mask"><span class="line-reveal">{{ section.settings.title_line1 }}</span></span>
        <span class="line-mask"><span class="line-reveal delay-1">{{ section.settings.title_line2_prefix }} <span class="script-accent script-underline">{{ section.settings.title_script }}</span></span></span>
      </h1>
      <p class="hero-desc reveal-up delay-2">
        Découvrez DASSA, la tisane glacée pétillante à l'hibiscus, disponible en deux saveurs rafraîchissantes :
        <strong class="text-mint">Menthe</strong> et <strong class="text-pineapple">Ananas</strong>.
      </p>
      <div class="hero-benefits reveal-up delay-3">
        <span class="hero-benefit"><span class="benefit-ring"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg></span>{{ section.settings.benefit_1 }}</span>
        <span class="hero-benefit"><span class="benefit-ring"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></span>{{ section.settings.benefit_2 }}</span>
        <span class="hero-benefit"><span class="benefit-ring"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M12 2v20m8-16-16 16m0-16 16 16"/></svg></span>{{ section.settings.benefit_3 }}</span>
      </div>
      <div class="hero-ctas reveal-up delay-4">
        <a href="{{ section.settings.cta1_link | default: '/#nos-boissons' }}" class="btn btn-cream" data-testid="hero-cta-boissons">{{ section.settings.cta1_label }} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="{{ section.settings.cta2_link | default: '/#ou-acheter' }}" class="btn btn-outline-cream" data-testid="hero-cta-locator">{{ section.settings.cta2_label }} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></a>
      </div>
    </div>
    <div class="hero-right">
      {% if section.settings.glass_image %}
        <img src="{{ section.settings.glass_image | image_url: width: 800 }}" alt="Verre de bissap DASSA glacé avec splash" class="hero-glass" width="800" height="1192">
      {% else %}
        <img src="{{ 'dassa-hero-glass.png' | asset_url }}" alt="Verre de bissap DASSA glacé avec splash" class="hero-glass" width="800" height="1192">
      {% endif %}
      {% if section.settings.can_1 %}
        <img src="{{ section.settings.can_1 | image_url: width: 850 }}" alt="Canette DASSA Bissap Pétillant Hibiscus-Menthe" class="hero-can hero-can-menthe" width="850" height="2000">
      {% else %}
        <img src="{{ 'dassa-can-menthe.png' | asset_url }}" alt="Canette DASSA Bissap Pétillant Hibiscus-Menthe" class="hero-can hero-can-menthe" width="850" height="2000">
      {% endif %}
      {% if section.settings.can_2 %}
        <img src="{{ section.settings.can_2 | image_url: width: 850 }}" alt="Canette DASSA Bissap Pétillant Hibiscus-Ananas" class="hero-can hero-can-ananas" width="850" height="2000">
      {% else %}
        <img src="{{ 'dassa-can-ananas.png' | asset_url }}" alt="Canette DASSA Bissap Pétillant Hibiscus-Ananas" class="hero-can hero-can-ananas" width="850" height="2000">
      {% endif %}
      {% if section.settings.show_badge %}
        <div class="hero-badge">{{ section.settings.badge_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero DASSA",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Bissap Pétillant" },
    { "type": "text", "id": "title_line1", "label": "Titre ligne 1", "default": "Le bissap prend" },
    { "type": "text", "id": "title_line2_prefix", "label": "Titre ligne 2 (avant script)", "default": "une" },
    { "type": "text", "id": "title_script", "label": "Texte manuscrit jaune", "default": "nouvelle dimension." },
    { "type": "text", "id": "benefit_1", "label": "Bénéfice 1", "default": "0 caféine" },
    { "type": "text", "id": "benefit_2", "label": "Bénéfice 2", "default": "0 théine" },
    { "type": "text", "id": "benefit_3", "label": "Bénéfice 3", "default": "À servir bien frais" },
    { "type": "text", "id": "cta1_label", "label": "CTA principal", "default": "Découvrir nos boissons" },
    { "type": "url", "id": "cta1_link", "label": "Lien CTA principal" },
    { "type": "text", "id": "cta2_label", "label": "CTA secondaire", "default": "Trouver DASSA près de moi" },
    { "type": "url", "id": "cta2_link", "label": "Lien CTA secondaire" },
    { "type": "image_picker", "id": "can_1", "label": "Canette Menthe (défaut : asset du thème)" },
    { "type": "image_picker", "id": "can_2", "label": "Canette Ananas (défaut : asset du thème)" },
    { "type": "image_picker", "id": "glass_image", "label": "Verre de bissap (défaut : asset du thème)" },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge Québec", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texte du badge", "default": "Ingrédients d'ici au Québec" }
  ],
  "presets": [{ "name": "Hero DASSA" }]
}
{% endschema %}
