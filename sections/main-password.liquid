<section class="page-section page-404">
  <div class="container-narrow center">
    <p class="hero-brand script-accent-red">DASSA<span class="accent-dot-orange">.</span></p>
    <h1 class="section-title">{{ 'general.password.title' | t }}</h1>
    <p class="section-sub">{{ 'general.password.subtitle' | t }}</p>
    {% form 'storefront_password' %}
      <div class="newsletter-fields">
        <input type="password" name="password" placeholder="Mot de passe" class="newsletter-input">
        <button type="submit" class="btn btn-red">Entrer</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
