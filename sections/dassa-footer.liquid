<footer class="footer" data-testid="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-script">{{ section.settings.tagline }}</p>
        <p class="footer-logo">DASSA<span class="accent-dot-orange">.</span></p>
        <p class="footer-desc">{{ section.settings.description }}</p>
      </div>
      <div class="footer-col">
        <h4>{{ section.settings.col1_title }}</h4>
        <ul>
          {%- if section.settings.col1_menu != blank -%}
            {%- for link in section.settings.col1_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/#nos-boissons">Nos boissons</a></li>
            <li><a href="/#nos-cocktails">Nos cocktails</a></li>
            <li><a href="/#ou-acheter">Où acheter</a></li>
            <li><a href="/#notre-histoire">Notre histoire</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ section.settings.col2_title }}</h4>
        <ul>
          {%- if section.settings.col2_menu != blank -%}
            {%- for link in section.settings.col2_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/#faq">Contact</a></li>
            <li><a href="/#faq">Livraison</a></li>
            <li><a href="/#faq">Retours</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Réseaux sociaux</h4>
        <div class="footer-socials">
          <a href="{{ section.settings.instagram_url | default: '#' }}" aria-label="Instagram" data-testid="social-instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
          <a href="{{ section.settings.facebook_url | default: '#' }}" aria-label="Facebook" data-testid="social-facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="{{ section.settings.tiktok_url | default: '#' }}" aria-label="TikTok" data-testid="social-tiktok"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-legal">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="/policies/privacy-policy">Politique de confidentialité</a>
          <a href="/policies/terms-of-service">Conditions générales</a>
          <a href="/policies/refund-policy">Politique de remboursement</a>
        {%- endif -%}
      </div>
      <p class="footer-copy">Copyright © DASSA.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page DASSA",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Bissap Pétillant" },
    { "type": "text", "id": "description", "label": "Description", "default": "La tisane glacée pétillante à l'hibiscus. 0 caféine, 0 théine, à servir bien frais." },
    { "type": "text", "id": "col1_title", "label": "Titre colonne 1", "default": "Découvrir" },
    { "type": "link_list", "id": "col1_menu", "label": "Menu colonne 1" },
    { "type": "text", "id": "col2_title", "label": "Titre colonne 2", "default": "Aide" },
    { "type": "link_list", "id": "col2_menu", "label": "Menu colonne 2" },
    { "type": "link_list", "id": "legal_menu", "label": "Menu légal" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" }
  ]
}
{% endschema %}
