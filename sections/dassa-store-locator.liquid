<section class="locator-section" id="ou-acheter">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <p class="section-kicker">{{ section.settings.kicker }}</p>
      <h2 class="section-title">{{ section.settings.title }} <span class="script-accent-red">{{ section.settings.title_script }}</span></h2>
      <p class="section-sub">{{ section.settings.subtitle }}</p>
    </div>

    <div class="locator-controls">
      <div class="locator-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" placeholder="Ville ou code postal…" data-store-search data-testid="store-search-input">
      </div>
      <button class="btn btn-red" data-store-locate data-testid="store-locate-btn">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg>
        Ma position
      </button>
    </div>

    <div class="locator-filters" data-city-filters>
      <button class="city-pill active" data-city="Toutes">Toutes</button>
      <button class="city-pill" data-city="Québec">Québec</button>
      <button class="city-pill" data-city="Lévis">Lévis</button>
      <button class="city-pill" data-city="Montréal">Montréal</button>
    </div>

    <div class="locator-grid">
      <div class="locator-map" id="dassa-map"></div>
      <div class="locator-list" data-store-list data-testid="store-list"></div>
    </div>
  </div>

  <script type="application/json" data-stores-json>
    [
      {% for block in section.blocks %}
        {% if block.settings.visible %}
        {
          "id": {{ block.id | json }},
          "name": {{ block.settings.name | json }},
          "address": {{ block.settings.address | json }},
          "city": {{ block.settings.city | json }},
          "lat": {{ block.settings.lat | default: 0 }},
          "lng": {{ block.settings.lng | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Store Locator DASSA",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "03 — Où acheter" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Trouvez DASSA" },
    { "type": "text", "id": "title_script", "label": "Titre manuscrit", "default": "près de chez vous." },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Entrez votre ville ou votre code postal pour trouver le point de vente DASSA le plus proche." }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "store",
      "name": "Point de vente",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom du magasin" },
        { "type": "text", "id": "address", "label": "Adresse complète" },
        { "type": "text", "id": "city", "label": "Ville (Québec, Lévis ou Montréal)", "default": "Québec" },
        { "type": "text", "id": "lat", "label": "Latitude" },
        { "type": "text", "id": "lng", "label": "Longitude" },
        { "type": "checkbox", "id": "visible", "label": "Visible publiquement", "default": true }
