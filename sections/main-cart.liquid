<section class="cart-page-section">
  <div class="container-narrow">
    <div class="section-head">
      <p class="section-kicker">Panier</p>
      <h2 class="section-title">{{ 'general.cart.title' | t }}</h2>
    </div>
    {% if cart.item_count == 0 %}
      <div class="cart-page-empty">
        <p>{{ 'general.cart.empty' | t }}</p>
        <a href="/#nos-boissons" class="btn btn-red">{{ 'general.cart.continue' | t }}</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page-items">
          {% for item in cart.items %}
            <div class="cart-page-item">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="100">
              {% endif %}
              <div class="cart-page-item-info">
                <p class="cart-item-name">{{ item.product.title }}</p>
                <p class="cart-item-variant">{{ item.variant.title }} · {{ item.price | money }}</p>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="qty-input">
              </div>
              <p class="cart-item-line">{{ item.final_line_price | money }}</p>
            </div>
          {% endfor %}
        </div>
        <div class="cart-page-foot">
          <div class="cart-row cart-row-total">
            <span>{{ 'general.cart.total' | t }}</span>
            <span class="cart-total">{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-page-actions">
            <button type="submit" name="update" class="btn btn-outline-dark">Mettre à jour</button>
            <button type="submit" name="checkout" class="btn btn-red">{{ 'general.cart.checkout' | t }} →</button>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
