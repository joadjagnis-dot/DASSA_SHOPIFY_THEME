<section class="benefits-section">
  <div class="container">
    <div class="benefits-card reveal-on-scroll" data-testid="benefits-card">
      {% for block in section.blocks %}
        <div class="benefit-item" {{ block.shopify_attributes }}>
          <span class="benefit-icon">
            {% case block.settings.icon %}
              {% when 'sparkles' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/></svg>
              {% when 'flower' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"/></svg>
              {% when 'party' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5.8 11.3 2 22l10.7-3.8M4 3h.01M22 8h.01M15 2h.01M22 20h.01M22 2l-2.2.7a2 2 0 0 0-1.3 2.5l.3 1a2 2 0 0 1-1.3 2.5l-1.5.5M11 13a2 2 0 0 0 2-2V9a2 2 0 0 1 2-2h2"/></svg>
              {% else %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {% endcase %}
          </span>
          <div>
            <p class="benefit-title">{{ block.settings.title }}</p>
            <p class="benefit-text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bénéfices DASSA",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "sparkles", "label": "Pétillant" },
          { "value": "flower", "label": "Hibiscus" },
          { "value": "party", "label": "Fête" },
          { "value": "pin", "label": "Localisation" }
        ], "default": "sparkles" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Pétillante et rafraîchissante" },
        { "type": "text", "id": "text", "label": "Texte", "default": "À savourer très froide avec des glaçons." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bénéfices DASSA",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "sparkles", "title": "Pétillante et rafraîchissante", "text": "À savourer très froide avec des glaçons." } },
        { "type": "benefit", "settings": { "icon": "flower", "title": "Inspirée du bissap", "text": "Une recette à base d'hibiscus." } },
        { "type": "benefit", "settings": { "icon": "party", "title": "Parfaite pour tous vos moments", "text": "Repas, BBQ, apéros, fêtes ou simplement pour le plaisir." } },
        { "type": "benefit", "settings": { "icon": "pin", "title": "Disponible près de chez vous", "text": "Retrouvez DASSA dans plusieurs points de vente au Québec." } }
      ]
    }
  ]
}
{% endschema %}
