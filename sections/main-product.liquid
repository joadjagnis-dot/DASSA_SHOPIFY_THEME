<section class="pdp-section">
  <div class="container pdp-grid">
    <div class="pdp-media" style="background-color: {{ section.settings.media_bg }};">
      <div class="condensation"></div>
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="pdp-can float-slow" width="800" height="800">
      {% endif %}
    </div>
    <div class="pdp-content">
      <p class="product-card-script script-accent-red">Bissap Pétillant</p>
      <h1 class="pdp-title">{{ product.title }}</h1>
      <p class="pdp-price" data-pdp-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      <div class="pdp-desc">{{ product.description }}</div>

      {% form 'product', product %}
        <div class="pack-selector pack-selector-dark" role="group" aria-label="Choisir un format">
          {% for variant in product.variants %}
            <label class="pack-pill pack-pill-dark">
              <input type="radio" name="id" value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if variant == product.selected_or_first_available_variant %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
              <span>{{ variant.title }} · {{ variant.price | money }}</span>
            </label>
          {% endfor %}
        </div>
        <div class="pdp-qty">
          <label for="pdp-quantity">{{ 'general.product.quantity' | t }}</label>
          <input type="number" id="pdp-quantity" name="quantity" value="1" min="1" class="qty-input">
        </div>
        <button type="submit" class="btn btn-red btn-full" data-pdp-add {% unless product.available %}disabled{% endunless %} data-testid="pdp-add-to-cart">
          {% if product.available %}{{ 'general.product.add_to_cart' | t }}{% else %}{{ 'general.product.sold_out' | t }}{% endif %}
        </button>
      {% endform %}
      <p class="product-card-meta meta-dark">355 ml · 0 caféine · 0 théine · À servir bien frais</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "color", "id": "media_bg", "label": "Couleur de fond du visuel", "default": "#B8322A" }
  ]
}
{% endschema %}
